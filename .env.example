# Copy to .env.local (never commit secrets). Production values live in Vercel.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3031

# --- Launch gate (set COMING_SOON=true on Vercel production until public launch) ---
COMING_SOON=false
# Comma-separated emails allowed to sign in while COMING_SOON is on
EARLY_ACCESS_EMAILS=you@example.com

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Optional product integrations ---
OPENAI_API_KEY=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
